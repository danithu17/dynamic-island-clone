      "items": [
        { "label": "Bold", "shortcut": "Ctrl+B", "action": "Ctrl+B" },
        { "label": "Italic", "shortcut": "Ctrl+I", "action": "Ctrl+I" },
        { "label": "Underline", "shortcut": "Ctrl+U", "action": "Ctrl+U" }
      ]
    },
    {
      "label": "Help",
      "items": [
        { "label": "Word Help", "shortcut": "F1", "action": "F1" }
      ]
    }
  ]
