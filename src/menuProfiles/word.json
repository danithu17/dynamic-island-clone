{
  "app": "Microsoft Word",
  "processNames": ["winword"],
  "menus": [
    {
      "label": "File",
      "items": [
        { "label": "New Document", "shortcut": "Ctrl+N", "action": "Ctrl+N" },
        { "label": "Open...", "shortcut": "Ctrl+O", "action": "Ctrl+O" },
        { "label": "Save", "shortcut": "Ctrl+S", "action": "Ctrl+S" },
        { "label": "Save As...", "shortcut": "F12", "action": "F12" },
        { "label": "Print...", "shortcut": "Ctrl+P", "action": "Ctrl+P" },
        { "type": "separator" },
        { "label": "Close Document", "shortcut": "Ctrl+W", "action": "Ctrl+W" }
      ]
    },
    {
      "label": "Edit",
      "items": [
        { "label": "Undo", "shortcut": "Ctrl+Z", "action": "Ctrl+Z" },
        { "label": "Redo", "shortcut": "Ctrl+Y", "action": "Ctrl+Y" },
