      ]
    },
    {
      "label": "View",
      "items": [
        { "label": "Refresh", "shortcut": "F5", "action": "F5" },
        { "label": "Preview Pane", "shortcut": "Alt+P", "action": "Alt+P" },
        { "label": "Details Pane", "shortcut": "Alt+Shift+P", "action": "Alt+Shift+P" },
        { "type": "separator" },
        { "label": "Full Screen", "shortcut": "F11", "action": "F11" }
      ]
    },
    {
      "label": "Help",
      "items": [
        { "label": "Help", "shortcut": "F1", "action": "F1" }
      ]
    }
