{
  "app": "Microsoft Excel",
  "processNames": ["excel"],
  "menus": [
    {
      "label": "File",
      "items": [
        { "label": "New Workbook", "shortcut": "Ctrl+N", "action": "Ctrl+N" },
        { "label": "Open...", "shortcut": "Ctrl+O", "action": "Ctrl+O" },
        { "label": "Save", "shortcut": "Ctrl+S", "action": "Ctrl+S" },
        { "label": "Save As...", "shortcut": "F12", "action": "F12" },
        { "label": "Print...", "shortcut": "Ctrl+P", "action": "Ctrl+P" },
        { "type": "separator" },
        { "label": "Close", "shortcut": "Ctrl+W", "action": "Ctrl+W" }
      ]
    },
    {
      "label": "Edit",
      "items": [
        { "label": "Undo", "shortcut": "Ctrl+Z", "action": "Ctrl+Z" },
        { "label": "Redo", "shortcut": "Ctrl+Y", "action": "Ctrl+Y" },
        { "type": "separator" },
        { "label": "Cut", "shortcut": "Ctrl+X", "action": "Ctrl+X" },
        { "label": "Copy", "shortcut": "Ctrl+C", "action": "Ctrl+C" },
        { "label": "Paste", "shortcut": "Ctrl+V", "action": "Ctrl+V" },
        { "label": "Select All", "shortcut": "Ctrl+A", "action": "Ctrl+A" },
        { "type": "separator" },
        { "label": "Find", "shortcut": "Ctrl+F", "action": "Ctrl+F" },
        { "label": "Replace", "shortcut": "Ctrl+H", "action": "Ctrl+H" }
      ]
    },
    {
      "label": "Insert",
      "items": [
        { "label": "Insert Cells...", "shortcut": "Ctrl+Shift+Plus", "action": "Ctrl+Shift+Plus" },
        { "label": "Delete Cells...", "shortcut": "Ctrl+-", "action": "Ctrl+-" },
        { "label": "Create Table", "shortcut": "Ctrl+T", "action": "Ctrl+T" }
      ]
    },
    {
      "label": "Help",
      "items": [
        { "label": "Excel Help", "shortcut": "F1", "action": "F1" }
      ]
    }
  ]
}
