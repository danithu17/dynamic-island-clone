{
  "app": "Windows Terminal / PowerShell / Command Prompt",
  "processNames": ["windowsterminal", "powershell", "pwsh", "cmd"],
  "menus": [
    {
      "label": "File",
      "items": [
        { "label": "New Tab", "shortcut": "Ctrl+Shift+T", "action": "Ctrl+Shift+T" },
        { "label": "New Window", "shortcut": "Ctrl+Shift+N", "action": "Ctrl+Shift+N" },
        { "type": "separator" },
        { "label": "Close Tab", "shortcut": "Ctrl+Shift+W", "action": "Ctrl+Shift+W" },
